{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build-${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "QT_VERSION_MAJOR": "6",
                "KDTOOLBOX_CXX20": "ON",
                "KDTOOLBOX_CXX23": "ON"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "displayName": "Dev build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "rel",
            "inherits": "base",
            "displayName": "Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "dev-clang",
            "inherits": "dev",
            "displayName": "Dev build (clang)",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "clazy",
            "inherits": "dev",
            "displayName": "Clazy build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clazy"
            }
        }
    ]
}
